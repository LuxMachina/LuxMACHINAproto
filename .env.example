# Lux Machina runs without any of these. The MVP keeps projects in the browser.
# Copy to .env only if you wire a real service. Do not commit .env.

# Optional. Auth is off by default (VITE_AUTH_ENABLED=false in this app).
VITE_AUTH_ENABLED=false
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=
GROK_PREVIEW_CLIENT_SECRET=
BETTER_AUTH_SECRET=

# Optional. No database is required for the current product.
DATABASE_URL=
